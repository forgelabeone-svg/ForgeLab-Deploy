# =============================================================================
# Trinexus Developer Companion — Environment Variables Template
# BEOCIA Kft. / Trinexus Aqua — Internal Developer Tool
# =============================================================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit the real .env file to version control.
# .env is in .gitignore — .env.example is safe to commit.
# =============================================================================

# -----------------------------------------------------------------------------
# UNAS API Configuration
# Get your API key from UNAS Admin > Settings > External connections > API
# -----------------------------------------------------------------------------
UNAS_API_BASE_URL=https://api.unas.eu/shop/
UNAS_API_KEY=<PASTE_REAL_UNAS_API_KEY_HERE>
UNAS_SHOP_DOMAIN=trinexus.hu
UNAS_SECONDARY_SHOP_DOMAIN=trinexus.at
UNAS_DEFAULT_LANG=base

# -----------------------------------------------------------------------------
# Safety Mode — default is READ ONLY
# Set to false only when you intentionally want to run write/destructive calls.
# When true: all set* methods are blocked and log a clear warning.
# When false: set* methods are allowed — use with extreme caution in production.
# -----------------------------------------------------------------------------
UNAS_READ_ONLY=true

# -----------------------------------------------------------------------------
# Token Cache (runtime only)
# Tokens are cached in memory during runtime and are NEVER persisted to disk
# unless UNAS_PERSIST_TOKEN=true is explicitly set (not recommended).
# Default: false
# -----------------------------------------------------------------------------
UNAS_PERSIST_TOKEN=false

# -----------------------------------------------------------------------------
# Request Timeouts (seconds)
# -----------------------------------------------------------------------------
UNAS_REQUEST_TIMEOUT=30
UNAS_LOGIN_TIMEOUT=15

# -----------------------------------------------------------------------------
# Logging
# Levels: DEBUG, INFO, WARNING, ERROR
# DEBUG will log request/response details (secrets are always masked).
# Never set DEBUG in production environments.
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_MASK_SECRETS=true

# -----------------------------------------------------------------------------
# Optional: Local API Bridge (Flask/FastAPI)
# Enables a local HTTP server so the Chrome Extension can call Python tools.
# Set BRIDGE_ENABLED=true to activate the bridge server.
# NEVER expose secrets through this bridge — it only returns safe data.
# -----------------------------------------------------------------------------
BRIDGE_ENABLED=false
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5000

# -----------------------------------------------------------------------------
# Chrome Extension Dev Settings
# These are used by scripts/generate_icons.py and development utilities only.
# -----------------------------------------------------------------------------
EXTENSION_NAME=Trinexus Developer Companion
EXTENSION_VERSION=1.4.0

# =============================================================================
# SETUP INSTRUCTIONS:
#
# 1. Copy this file:
#      cp .env.example .env
#
# 2. Open .env and replace <PASTE_REAL_UNAS_API_KEY_HERE> with your actual key.
#
# 3. Verify your .gitignore contains:
#      .env
#      *.pyc
#      __pycache__/
#      .venv/
#
# 4. Run the tool:
#      python3 -m venv .venv
#      source .venv/bin/activate     # Windows: .venv\Scripts\activate
#      pip install -r requirements.txt
#      python main.py healthcheck
#
# 5. If UNAS_API_KEY is missing or empty, the client will exit with a clear
#    error message — it will NOT attempt fake API calls.
# =============================================================================
// [FL:DONE]