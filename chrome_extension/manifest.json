{
  "manifest_version": 3,
  "name": "Trinexus Developer Companion",
  "short_name": "TDC",
  "version": "1.4.0",
  "description": "Smart Tab Manager and UNAS API developer tool for BEOCIA Kft. / Trinexus Aqua internal development use.",
  "author": "BEOCIA Kft.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trinexus Developer Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "102"
}